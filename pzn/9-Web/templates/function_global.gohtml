<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
</head>
<body>
    <p>Name : {{.Name}}</p>
    <p>Length : {{len .Name}}</p>
    {{if gt (len .Name) 3}}
        <p>Long name</p>
    {{else}}
        <p>Short name</p>
    {{end}}
</body>
</html>
