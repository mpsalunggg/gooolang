<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
</head>
<body>
    <p>Original : {{.Name}}</p>
    <p>Upper : {{upper .Name}}</p>
    <p>Pipeline : {{.Name | upper}}</p>
</body>
</html>
